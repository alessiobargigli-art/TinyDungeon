{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tinydungeon-room",
  "main": "src/index.js",
  "compatibility_date": "2026-09-16",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" }
    ]
  },
  "exports": {
    "Room": { "type": "durable-object", "storage": "sqlite" }
  }
}
